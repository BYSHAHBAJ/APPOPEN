# ==========================================================================
# APNA FPS UNLOCKER - High-Performance Bandwidth Saver & Server Cache Directives
# Compatible with Apache, LiteSpeed, Hostinger, cPanel, and Cloudflare
# Reduces Hosting Bandwidth by 70% to 90%
# ==========================================================================

# 1. ENABLE BROTLI & GZIP COMPRESSION (Reduces text/code payload by 75-80%)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/x-javascript application/javascript text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/x-javascript application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE application/xml text/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# 2. DISABLE ETAGS (Saves Thousands of Unnecessary 304 Roundtrips & Header Bandwidth)
FileETag None

# 3. BROWSER CACHING DIRECTIVES (Zero-Bandwidth Repeat Visits)
<IfModule mod_expires.c>
  ExpiresActive On

  # Images: Cache locally for 1 Year (Browser stores locally, 0 bytes bandwidth)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # CSS & JavaScript: Cache locally for 1 Year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Web Fonts: Cache for 1 Year
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # Data & JSON: Cache for 30 minutes
  ExpiresByType application/json "access plus 30 minutes"
  ExpiresByType application/ld+json "access plus 1 day"

  # HTML: Cache for 1 hour (Guarantees updates reflect promptly)
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # 1-Year Immutable Caching for Static Assets (Images, Fonts, CSS, JS)
  <FilesMatch "\.(webp|png|jpg|jpeg|ico|svg|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML Short-term Caching with Revalidation
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Update JSON API Caching
  <FilesMatch "\.(json)$">
    Header set Cache-Control "public, max-age=1800, stale-while-revalidate=3600"
  </FilesMatch>

  # Security & Compression Headers
  Header append Vary "Accept-Encoding"
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# 4. PREVENT IMAGE HOTLINKING (Stops external sites & forums from stealing bandwidth)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?apnafpsbooster\.com [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?google\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?bing\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?yahoo\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?youtube\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?t\.me [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?instagram\. [NC]
  RewriteRule \.(webp|jpg|jpeg|png)$ - [F,L]
</IfModule>
